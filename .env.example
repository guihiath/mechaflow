# Variaveis de ambiente do MechaFlow.
# Copie este arquivo para .env.local e preencha. NUNCA commite .env.local.
#
# Ambientes (dois projetos Supabase separados):
# - staging:  testes e prototipo, so dados ficticios. Usado no .env.local e na
#             branch de teste da Vercel (Preview).
# - producao: oficinas reais. Valores cadastrados SO na Vercel (Production, branch main).
#             Nunca use as chaves de producao na maquina local.
#
# Onde achar: painel do Supabase > Project Settings > API Keys.
# Use a chave "publishable" (sb_publishable_...). Ela e publica por natureza;
# a seguranca vem das politicas RLS no banco.
# A chave "secret"/service_role NUNCA vai com prefixo NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "producao" so na Vercel Production. Vazio ou "staging" mostra a faixa TESTE no app.
NEXT_PUBLIC_AMBIENTE=staging

# Endereco publico do app, sem barra no fim. E dele que sai o link do orcamento que vai para o
# cliente (nunca do cabecalho da requisicao). Sem ela, "Gerar link" recusa e nada e gerado.
# Staging: https://mechaflow-git-staging-guihiaths-projects.vercel.app
URL_PUBLICA_APP=

# WhatsApp do suporte do MechaFlow (DESIGN §15.6): so digitos, com DDI e DDD (ex.: 5511999999999).
# Nao e segredo (vai no link da pagina). Vazio: "Falar no WhatsApp" e "Falar com o suporte" somem.
NEXT_PUBLIC_SUPORTE_WHATSAPP=

# Seed do staging (npm run seed:staging). So no .env.local, nunca na Vercel.
# SEED_EMAIL_BASE: e-mail de verdade, com o qual os +apelidos funcionam
#   (fulano@gmail.com gera fulano+mf-dono@gmail.com, +mf-atendente e +mf-mecanico).
# SEED_SENHA: senha das 3 contas. Quem escolhe e coloca aqui e o Guilherme; nao vai no chat nem no codigo.
# SEED_SUFIXO: opcional. Gera outra oficina limpa, com e-mails e nome proprios (ex.: ensaio).
SEED_EMAIL_BASE=
SEED_SENHA=
SEED_SUFIXO=
