# Variaveis de ambiente do MechaFlow.
# Copie este arquivo para .env.local e preencha. NUNCA commite .env.local.
#
# Ambientes (dois projetos Supabase separados):
# - staging:  testes e prototipo, so dados ficticios. Usado no .env.local e na
#             branch de teste da Vercel (Preview).
# - producao: oficinas reais. Valores cadastrados SO na Vercel (Production, branch main).
#             Nunca use as chaves de producao na maquina local.
#
# Onde achar: painel do Supabase > Project Settings > API Keys.
# Use a chave "publishable" (sb_publishable_...). Ela e publica por natureza;
# a seguranca vem das politicas RLS no banco.
# A chave "secret"/service_role NUNCA vai com prefixo NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "producao" so na Vercel Production. Vazio ou "staging" mostra a faixa TESTE no app.
NEXT_PUBLIC_AMBIENTE=staging
